# Copy to turnserver.conf and replace placeholders before starting coturn.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_SHARED_SECRET
realm=turn.example.com
min-port=49160
max-port=49200
no-multicast-peers
no-cli
# For a server behind NAT, configure the public address:
# external-ip=PUBLIC_IPV4/PRIVATE_IPV4
# Configure a trusted certificate/key pair before enabling turns: URLs:
# cert=/etc/coturn/cert.pem
# pkey=/etc/coturn/privkey.pem
